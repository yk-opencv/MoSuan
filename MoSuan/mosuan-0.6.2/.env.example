# Optional official API connection. Never send this key to a web proxy.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
PORT=3001
HOST=127.0.0.1
# The UI remembers your connection choice locally; default is official.
# Web mode uses the separate local proxy and its own browser login.
DEEPSEEK_WEB_BASE_URL=http://127.0.0.1:9655/v1
# Leave blank to select a model advertised by the proxy.
DEEPSEEK_WEB_MODEL=
